{
  "name": "frontend",
  "private": true,
  "version": "0.8.19",
  "type": "module",
  "license": "BSD-3-Clause",
  "scripts": {
    "gen-csapi": "dts-bundle-generator --project ./tsconfig.json ./src/window.d.ts --inline-declare-global --external-types=react --external-inlines=@xterm/xterm --external-inlines=@xterm/addon-search --external-types=zustand --external-types=csstype --external-types=liquidjs -o ./csapi.d.ts",
